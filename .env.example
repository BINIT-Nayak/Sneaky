# Copy to .env.local for local development, or add these values in your deploy platform.
# Vite exposes only VITE_* variables to frontend code.

# Production example: https://api.your-domain.com
# Local dev can stay empty when using the Vite /api proxy.
VITE_API_BASE_URL=

# Local development only: backend target for the Vite /api proxy.
VITE_DEV_PROXY_TARGET=http://localhost:8081
